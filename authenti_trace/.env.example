# Copy to .env (never commit .env). Used by docker-compose.yml and as a list of every setting.

# --- required for docker compose ---
POSTGRES_PASSWORD=change-me
# label:key pairs. The label is the caller's identity (shown as the reviewer on review decisions).
API_KEYS=reviewer:replace-with-a-long-random-key
# One key from API_KEYS. Only the web server sees it; the browser never does.
BACKEND_API_KEY=replace-with-a-long-random-key
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- optional (defaults shown) ---
# DATABASE_URL=sqlite+aiosqlite:///<backend>/authentitrace.db   or postgresql+asyncpg://user:pass@host/db
# CELERY_BROKER_URL=redis://localhost:6379/0     unset = jobs run inside the API process
# STORAGE_DIR=<backend>/storage
# OBJECT_STORE=local                             or s3 (then S3_BUCKET, S3_PREFIX, S3_ENDPOINT_URL)
# MEDIA_RETENTION_DAYS=0                         0 keeps files forever; use 30 in production
# LEDGER_ANCHOR_PATH=<backend>/ledger_anchor.jsonl
# RATE_LIMIT_UPLOADS_PER_MINUTE=30
# RATE_LIMIT_PER_MINUTE=300
# RATE_LIMIT_HEAVY_PER_MINUTE=6                 ledger audit
# REQUIRE_API_KEYS=true                          refuse to start without API_KEYS (compose sets it)
# SIGNAL_TIMEOUT_SECONDS=60
# JOB_MAX_ATTEMPTS=2
# MAX_IMAGE_PIXELS=25000000
# REGISTRY_DIR=<backend>/registry                malicious_sha256.txt, synthetic_dhash.txt
# IMAGE_MODEL_PATH=                              ONNX detector (needs requirements-ml.txt)
# CALIBRATION_PATH=<backend>/calibration.json
# FUSION_PATH=<backend>/fusion.json
# SCORING_MIN_EVIDENCE=1.0
# SCORING_MAX_DISAGREEMENT=50
# EVAL_RESULTS_PATH=<backend>/eval/results/latest.json
